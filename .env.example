# Yahoo Mail credentials (enable yahoo when set; requires both)
YAHOO_EMAIL=yourname@yahoo.com
YAHOO_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Providers to scan in one run (comma-separated: yahoo, m365).
# Leave unset to auto-detect: each provider with complete credentials runs.
# Set explicitly to pin the list, e.g. m365-only: PROVIDERS=m365
# PROVIDERS=yahoo,m365

# IMAP settings
IMAP_HOST=imap.mail.yahoo.com
IMAP_PORT=993
MAILBOX=INBOX
DEST_FOLDER=Promotional
TRASH_FOLDER=Bulk Mail

# Microsoft 365 settings (enable m365 when set; all four required)
# Azure app registration with Graph application permissions:
#   Mail.Read + Mail.ReadWrite, admin consented. See README for the walkthrough.
M365_TENANT_ID=your-tenant-guid
M365_CLIENT_ID=your-app-client-id
M365_CLIENT_SECRET=your-client-secret-value
M365_MAILBOX=user@yourtenant.com
# Folder to scan inside the M365 mailbox (well-known names like INBOX work)
M365_MAILBOX_FOLDER=INBOX

# Interactive mode (default: true)
# Set to false to run automatically without confirmation
INTERACTIVE=true

# SQLite database location
# Docker: use /data/state.sqlite
# Local: use ./data/state.sqlite
SQLITE_PATH=./data/state.sqlite

# LLM Configuration
# Use openrouter/ prefix for OpenRouter models
# LLM_MODEL=llama3.2
LLM_MODEL=openrouter/google/gemini-2.5-flash

# Maximum characters to send to LLM (default: 1120000 = ~800K tokens)
# Gemini 2.5 Flash supports up to 1M tokens, but we need buffer for prompt overhead
LLM_MAX_CHARS=1120000

# Set your OpenRouter API key as environment variable:
# (or use: llm keys set openrouter)
OPENROUTER_KEY=sk-or-...

# Ollama API endpoint (when not using default)
# OLLAMA_API_BASE=http://localhost:11434

# Rspamd settings
# Docker: use http://rspamd:11333/checkv2
# Local: use http://127.0.0.1:11333/checkv2
RSPAMD_URL=http://127.0.0.1:11333/checkv2
RSPAMD_SPAM_SCORE=6.0
RSPAMD_TRASH_SCORE=7.0

# Historical learning settings
# How much influence past actions have (0.0 = disabled, 1.0 = strong influence)
HISTORY_WEIGHT=0.3
# Minimum past emails from a domain before using history
HISTORY_MIN_SAMPLES=3
